<?xml version="1.0" encoding="UTF-8"?>
<!--
  x500 de PX4 con una pelota encima, que hace de checkpoint movil.

  La pelota es solo visual (sin colision) y casi sin masa, para no cambiar el vuelo.
  Su centro esta a 2.5 m sobre base_link (ball_offset del estimation_evaluator): asi
  el interceptor puede atravesarla sin chocar con el dron que la lleva. Diametro 1.0 m: el true_size del evaluador. El estimador NO
  conoce ninguno de los dos.
-->
<sdf version='1.9'>
  <model name='x500_ball'>
    <include merge='true'>
      <uri>x500</uri>
    </include>
    <link name='ball_link'>
      <pose relative_to='base_link'>0 0 2.5 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name='ball_visual'>
        <geometry>
          <sphere>
            <radius>0.5</radius>
          </sphere>
        </geometry>
        <!-- Textura de balon de futbol (tools/make_ball_texture.py): YOLO la reconoce
             como "sports ball" de 3 a 16 m; la naranja lisa salia como "orange". -->
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/soccer.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>0.6</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
    <joint name='ball_joint' type='fixed'>
      <parent>base_link</parent>
      <child>ball_link</child>
    </joint>
  </model>
</sdf>
